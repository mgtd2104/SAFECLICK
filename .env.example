# SafeClick configuration example.
#
# Copy this file to `.env`, then edit the values. Never commit a real `.env`.
# The app runs with safe defaults and NO `.env` at all; every variable here is
# optional and exists mainly to turn on the optional AI assistance.
#
# Loading `.env`:
#   uvicorn backend.app.main:app --env-file .env   (needs the `python-dotenv` package)
#   ...or export the variables in your shell before starting the servers.

# --- Optional AI assistance (disabled by default) ---
# Keep false to run the rule engine only, with no external calls at all.
ENABLE_LLM=false

# OpenAI-compatible endpoint. Examples:
#   NVIDIA NIM:     https://integrate.api.nvidia.com/v1
#   Ollama (local): http://localhost:11434/v1
#   LM Studio:      http://localhost:1234/v1
LLM_BASE_URL=

# Provider credential. Leave empty for keyless local models. Never commit it.
LLM_API_KEY=

# Model identifier exactly as the provider lists it.
LLM_MODEL=

# Allow a local/private-network endpoint. Off by default as SSRF protection.
LLM_ALLOW_PRIVATE_NETWORK=false

# --- API and UI ---
# Comma-separated CORS origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Base URL the Streamlit UI uses to reach the API.
SAFECLICK_API_BASE_URL=http://127.0.0.1:8000
